---
import BaseLayout from './BaseLayout.astro';
import { serviceNode, type CatalogItem } from '../lib/schema-graph';

export interface Props {
  location: {
    name: string;
    state: string;
    region: string;
    slug: string;
    seo: {
      title: string;
      description: string;
    };
    coordinates?: {
      lat: number;
      lng: number;
    };
  };
  /** Servicios que la pagina enlaza, para el catalogo del schema. */
  services?: CatalogItem[];
}

const { location, services = [] } = Astro.props;

const geoRegion = location.region === 'SC' ? 'US-SC' : 'US-NC';
const geoPlacename = location.name;

// Schema de la zona (modelo de Sebastian): un Service del negocio en esta ciudad.
// Antes era un segundo LocalBusiness con @id propio, direccion en la ciudad de la
// zona y otro correo: para Google, un negocio distinto con sede en cada zona.
const pagePath = `/service-areas/${location.slug}`;
const stateName = location.state === 'NC' ? 'North Carolina' : 'South Carolina';
const zoneServiceSchema = {
  "@context": "https://schema.org",
  ...serviceNode({
    path: pagePath,
    name: `Handyman & Remodeling Services in ${location.name}, ${location.state}`,
    serviceType: "Handyman and remodeling services",
    description: location.seo.description,
    areaServed: {
      "@type": "City",
      "name": location.name,
      "containedInPlace": { "@type": "State", "name": stateName }
    },
    catalogName: `Services in ${location.name}, ${location.state}`,
    catalog: services
  })
};

const breadcrumb = [
  { name: "Home", path: "/" },
  { name: "Service Areas", path: "/service-areas" },
  { name: `${location.name}, ${location.state}`, path: pagePath }
];
---

<BaseLayout
  title={location.seo.title}
  description={location.seo.description}
  canonical={`/service-areas/${location.slug}`}
  geoRegion={geoRegion}
  geoPlacename={geoPlacename}
  breadcrumb={breadcrumb}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(zoneServiceSchema)} />
  </Fragment>

  <slot />
</BaseLayout>
