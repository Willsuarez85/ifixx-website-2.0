---
import BaseLayout from './BaseLayout.astro';
import { pageIds, serviceNode } from '../lib/schema-graph';

export interface ServiceItem {
  name: string;
  slug: string;
  description: string;
  image?: string;
}

export interface Props {
  pillar: {
    title: string;
    slug: string;
    description: string;
    seo: {
      title: string;
      description: string;
    };
  };
  services: ServiceItem[];
}

const { pillar, services } = Astro.props;

// ItemList schema for the services under this pillar
const pagePath = `/${pillar.slug}`;
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": pageIds(pagePath).list,
  "name": pillar.title,
  "description": pillar.description,
  "numberOfItems": services.length,
  "itemListElement": services.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": service.name,
    "url": `https://www.ifixxnc.com/${pillar.slug}/${service.slug}`
  }))
};

// Service del pilar: antes declaraba un negocio sin @id, un radio de 50 millas
// desde el centro de Charlotte y "North Carolina" entero, contra las nueve zonas
// que publica business-facts.ts. Ahora es el negocio por @id y sus zonas.
const serviceSchema = {
  "@context": "https://schema.org",
  ...serviceNode({
    path: pagePath,
    name: pillar.title,
    serviceType: pillar.title,
    description: pillar.seo.description,
    catalogName: pillar.title,
    catalog: services.map((service) => ({ name: service.name, url: `/${pillar.slug}/${service.slug}` }))
  })
};

const breadcrumb = [
  { name: "Home", path: "/" },
  { name: pillar.title, path: pagePath }
];
---

<BaseLayout
  title={pillar.seo.title}
  description={pillar.seo.description}
  canonical={`/${pillar.slug}`}
  breadcrumb={breadcrumb}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <slot />
</BaseLayout>
