---
import '../styles/global.css';
import { businessNode } from '../lib/business-schema';
import {
  breadcrumbNode,
  webPageNode,
  websiteNode,
  type Crumb,
  type Faq
} from '../lib/schema-graph';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AttributionScript from '../components/common/AttributionScript.astro';
import EnhancedConversionsScript from '../components/common/EnhancedConversionsScript.astro';

// Medidas reales de la imagen por defecto. Una ogImage propia de la pagina sale sin
// medidas: declarar unas que no son le miente a quien arma la vista previa.
const DEFAULT_OG_IMAGE = '/images/ui/hero-bg.jpg';
const DEFAULT_OG_SIZE = { width: 1600, height: 900 };

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Texto alternativo de ogImage. Sin el, se usa el nombre del negocio. */
  ogImageAlt?: string;
  canonical?: string;
  geoRegion?: string;
  geoPlacename?: string;
  noindex?: boolean;
  /** Tipo schema.org del nodo de la pagina: WebPage, AboutPage, ContactPage, CollectionPage. */
  pageType?: string;
  /** FAQ visibles de la pagina. Se publican en el mismo nodo (["WebPage", "FAQPage"]). */
  faqs?: Faq[];
  /** Migas de la pagina, de la home a ella misma. */
  breadcrumb?: Crumb[];
}

const {
  title,
  description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'iFixx Remodeling & Handyman Services - South Charlotte, NC',
  canonical,
  geoRegion = 'US-NC',
  geoPlacename = 'Charlotte',
  // noindex renders "noindex, follow": a pruned page stops being indexed but keeps
  // passing link equity to the canonical silo it points at.
  noindex = false,
  pageType,
  faqs,
  breadcrumb
} = Astro.props;
const siteUrl = 'https://www.ifixxnc.com';
// Always force www canonical — prevents duplicate indexing between ifixxnc.com and www.ifixxnc.com
const rawCanonical = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const fullCanonical = rawCanonical.replace('https://ifixxnc.com', 'https://www.ifixxnc.com');

// Un solo bloque JSON-LD con el grafo base de la pagina: negocio, sitio, la pagina
// y sus migas. Los nodos propios de cada plantilla (Service, ItemList, BlogPosting)
// llegan por el slot "schema" y se enlazan a estos por @id.
const pagePath = canonical ?? Astro.url.pathname;
const hasBreadcrumb = Array.isArray(breadcrumb) && breadcrumb.length > 0;
const pageGraph = {
  "@context": "https://schema.org",
  "@graph": [
    businessNode(),
    websiteNode(),
    webPageNode({ path: pagePath, name: title, description, pageType, faqs, hasBreadcrumb }),
    ...(hasBreadcrumb ? [breadcrumbNode(pagePath, breadcrumb!)] : [])
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <!-- Google Tag Manager — GTM-KXPL7CDR (new clean account, 2026-02-26) -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KXPL7CDR');</script>
  <!-- End Google Tag Manager -->

  <!-- Google Tag (gtag.js) - GA4 + Google Ads -->
  <!-- Fixed 2026-02-09: Corrected Measurement ID and Ads ID -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XV0NEL86VN" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XV0NEL86VN');  // GA4 Measurement ID
    gtag('config', 'AW-17542077404'); // Google Ads Conversion Tag
  </script>

  <AttributionScript />
  <EnhancedConversionsScript />

  <!-- Click-to-Call Tracking -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('a[href^="tel:"]').forEach(function(link) {
        link.addEventListener('click', function() {
          if (typeof gtag !== 'undefined') {
            gtag('event', 'click_to_call', {
              'event_category': 'engagement',
              'event_label': this.href.replace('tel:', ''),
              'value': 1
            });
            gtag('event', 'conversion', {
              'send_to': 'AW-17542077404/QjnuCMqS4PIbENy326xB',  // Phone Click conversion
              'value': 50.0,
              'currency': 'USD'
            });
          }
          console.log('[iFIXX] Click-to-Call tracked:', this.href);
        });
      });
    });
  </script>
  <!-- End Google Tag -->

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Preload local fonts for faster rendering -->
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Preload critical hero image for LCP -->
  <link
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/ui/hero-bg.webp"
    imagesrcset="/images/ui/hero-bg-640.webp 640w, /images/ui/hero-bg-1024.webp 1024w, /images/ui/hero-bg.webp 1600w"
    imagesizes="100vw"
    fetchpriority="high"
  />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="iFixx Remodeling & Handyman Services" />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:type" content={ogImage.endsWith('.webp') ? 'image/webp' : ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
  {ogImage === DEFAULT_OG_IMAGE && (
    <>
      <meta property="og:image:width" content={String(DEFAULT_OG_SIZE.width)} />
      <meta property="og:image:height" content={String(DEFAULT_OG_SIZE.height)} />
    </>
  )}
  <meta property="og:image:alt" content={ogImageAlt} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@ifixxnc" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Canonical -->
  <link rel="canonical" href={fullCanonical} />

  <!-- Additional SEO Meta -->
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  <meta name="author" content="iFixx Remodeling & Handyman Services" />
  <meta name="geo.region" content={geoRegion} />
  <meta name="geo.placename" content={geoPlacename} />

  <title>{title}</title>

  <!-- Grafo JSON-LD base: negocio, sitio, pagina y migas -->
  <script type="application/ld+json" set:html={JSON.stringify(pageGraph)} />

  <!-- JSON-LD Schema Slot -->
  <slot name="schema" />
</head>
<body class="min-h-screen bg-white antialiased flex flex-col">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KXPL7CDR" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <Header />
  <main class="flex-grow">
    <slot />
  </main>
  <Footer />
  
  <!-- Analytics Slot -->
  <slot name="analytics" />
</body>
</html>
