---
import { GOOGLE_REVIEW_COUNT, GOOGLE_RATING } from '../../lib/business-facts';
import { GOOGLE_REVIEWS, GOOGLE_PROFILE_URL, reviewDateLabel } from '../../lib/google-reviews';

interface Props {
  segment?: 'homeowner' | 'property-manager' | 'all';
  title?: string;
  subtitle?: string;
  maxItems?: number;
}

const {
  segment = 'all',
  title = 'What Our Customers Say',
  subtitle = "Don't just take our word for it — every review below is on our Google Business Profile.",
  maxItems = 6
} = Astro.props;

// Este bloque publicaba 8 testimonios redactados: nombres, barrios, empresas de
// administracion de propiedades y numeros de unidades sin ningun respaldo, mas dos
// que describian trabajo de plomeria (fuga de bano, tuberia rota a las 2am), que
// iFIXX no ofrece. Se retiraron el 2026-09-17. El sitio solo muestra resenas que
// existen en el Google Business Profile: src/lib/google-reviews.ts.
//
// `segment` se conserva porque /for-homeowners y /for-property-managers lo pasan,
// pero ya no filtra: no hay resenas verificadas segmentadas. Cuando el GBP tenga
// una de un property manager, se anade al archivo con su etiqueta.
//
// GOOGLE_REVIEWS viene de la mas reciente a la mas antigua, asi que esto muestra
// las N mas recientes del perfil.
const testimonials = GOOGLE_REVIEWS.slice(0, maxItems);

const displaySubtitle = segment === 'property-manager'
  ? 'Every review below is public on our Google Business Profile.'
  : subtitle;

// El texto se guarda completo; si es largo se recorta solo visualmente.
const LONG_REVIEW = 260;
---

{testimonials.length > 0 && (
<section class="section section-alt">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
      <h2 class="text-3xl lg:text-4xl font-heading font-bold text-neutral-900 mb-4">
        {title}
      </h2>
      <p class="text-lg text-neutral-600">
        {displaySubtitle}
      </p>
      <p class="mt-4 text-neutral-700 font-semibold">
        {GOOGLE_RATING} stars across {GOOGLE_REVIEW_COUNT} Google reviews
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {testimonials.map((testimonial, index) => (
        <div class="card p-6 lg:p-8">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote (verbatim; si es larga se recorta solo a la vista) -->
          {testimonial.text.length > LONG_REVIEW ? (
            <div class="mb-6">
              <input type="checkbox" id={`tm-${index}-${testimonial.datePublished}`} class="peer sr-only" />
              <blockquote class="text-neutral-700 leading-relaxed whitespace-pre-line line-clamp-5 peer-checked:line-clamp-none">
                "{testimonial.text}"
              </blockquote>
              <label
                for={`tm-${index}-${testimonial.datePublished}`}
                class="mt-1 inline-block cursor-pointer text-sm font-semibold text-primary-600 hover:text-primary-700 peer-checked:hidden"
              >
                Read more
              </label>
            </div>
          ) : (
            <blockquote class="text-neutral-700 leading-relaxed whitespace-pre-line mb-6">
              "{testimonial.text}"
            </blockquote>
          )}

          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center shrink-0">
              <span class="text-primary-600 font-semibold text-sm">
                {testimonial.author.charAt(0)}
              </span>
            </div>
            <div>
              <p class="font-semibold text-neutral-900">{testimonial.author}</p>
              <a
                href={testimonial.reviewUrl ?? GOOGLE_PROFILE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-neutral-500 hover:text-primary-600 transition-colors"
              >
                Review on Google · {reviewDateLabel(testimonial.datePublished)}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Reviews Link -->
    <div class="text-center mt-10">
      <a
        href={GOOGLE_PROFILE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-primary-600 font-medium hover:text-primary-700 transition-colors"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
        </svg>
        Read all {GOOGLE_REVIEW_COUNT} reviews on Google
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>
)}
