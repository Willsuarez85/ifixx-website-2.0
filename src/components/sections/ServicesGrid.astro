---
// "El pan de cada dia de iFIXX es remodeling, drywall repair y deck repairs"
// (William, 2026-09-19). Those three lead the home page in their own large block
// right under the hero; everything else iFIXX does follows in a smaller grid.
//
// Earlier decisions this keeps: "reparar primero, remodelar despues" (2026-09-17),
// so repairs still come before remodeling inside the secondary grid, and fences
// stay out of the home page because the category moves to a separate brand in
// October.
const core = [
  {
    title: 'Drywall Repair',
    description:
      'Holes, cracks, nail pops, water-stained ceilings, and texture matching that hides the patch. The repair nobody else wants to drive out for is the one we do every day.',
    image: '/images/projects/drywall-repair-patching-hole-spackling.webp',
    href: '/repairs/drywall'
  },
  {
    title: 'Deck Repair & Restoration',
    description:
      'Soft boards, wood rot, loose railings, and steps that flex. Sanding, staining, and sealing that brings the wood back. We look for the repair before we talk about a rebuild.',
    image: '/images/projects/deck-wood-railing-south-charlotte.webp',
    href: '/repairs/deck-repair'
  },
  {
    title: 'Kitchen & Bathroom Remodeling',
    description:
      'Full kitchen and bathroom renovations, priced in writing before we start. Estimates are done in person, and projects over $5,000 include a render so you see it before we build it.',
    image: '/images/projects/kitchen-remodeling-complete-modern-white-cabinets-island.webp',
    href: '/remodeling'
  }
];

const alsoRepairs = [
  {
    title: 'Painting',
    description: 'Interior and exterior, with the prep done right.',
    href: '/repairs/painting'
  },
  {
    title: 'Doors & Windows',
    description: 'Sticking doors, drafty frames, rotted posts, tired hardware.',
    href: '/repairs/doors-windows'
  },
  {
    title: 'Fence Repair',
    description: 'Leaning posts, sagging gates, sections down after a storm.',
    href: '/repairs/fence-repair'
  },
  {
    title: 'Carpentry & Trim',
    description: 'Baseboards, trim, shelving, and custom woodwork.',
    href: '/repairs/carpentry'
  },
  {
    title: 'Quick Fixes',
    description: 'The list on the fridge. Small jobs nobody else will take.',
    href: '/repairs/quick-fix'
  },
  {
    title: 'TV Mounting',
    description: 'Any size, cables hidden, above-fireplace mounts included.',
    href: '/repairs/tv-mounting'
  }
];

const alsoRemodeling = [
  {
    title: 'Deck Building',
    description: 'New decks and rebuilds in pressure-treated wood, cedar, or composite.',
    href: '/remodeling/decks'
  },
  {
    title: 'Screened Porches',
    description: 'Turn three usable months into nine. New builds and deck-to-porch conversions.',
    href: '/remodeling/screened-porches'
  },
  {
    title: 'Flooring Installation',
    description: 'Hardwood, LVP, and tile installed level and finished clean.',
    href: '/remodeling/flooring-installation'
  }
];
---

<section class="section">
  <div class="container">
    <!-- The three things iFIXX does every day -->
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
      <h2 class="text-3xl lg:text-4xl font-heading font-bold text-neutral-900 mb-4">
        What We Do Every Day
      </h2>
      <p class="text-lg text-neutral-600">
        Drywall, decks, and remodeling are the work that fills our week. Minimum for a
        repair visit is $200, and you get the price before we start.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {core.map((service) => (
        <a href={service.href} class="group relative block rounded-xl overflow-hidden aspect-[3/4] md:aspect-[4/5] shadow-lg">
          <img
            src={service.image}
            alt={`${service.title} in South Charlotte NC - iFixx`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            width="500"
            height="625"
            loading="eager"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/95 via-neutral-900/60 to-transparent"></div>
          <div class="absolute inset-0 flex flex-col justify-end p-6 lg:p-7">
            <h3 class="text-2xl lg:text-3xl font-heading font-bold text-white mb-3 group-hover:text-primary-400 transition-colors">
              {service.title}
            </h3>
            <p class="text-neutral-200 text-sm lg:text-base leading-relaxed mb-4">
              {service.description}
            </p>
            <span class="inline-flex items-center text-primary-400 font-semibold text-sm group-hover:gap-2 transition-all">
              View Service
              <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Everything else, smaller -->
    <div class="mt-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl lg:text-3xl font-heading font-bold text-neutral-900 mb-3">
          And Everything Else Around the House
        </h2>
        <p class="text-neutral-600">
          Most of our remodels start as one of these. By the time you hand us the kitchen,
          you already know how we work.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[...alsoRepairs, ...alsoRemodeling].map((service) => (
          <a
            href={service.href}
            class="group flex items-start gap-3 p-5 rounded-xl border border-neutral-200 bg-white hover:border-primary-400 hover:shadow-md transition-all"
          >
            <span class="w-8 h-8 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="block font-heading font-bold text-neutral-900 group-hover:text-primary-600 transition-colors">
                {service.title}
              </span>
              <span class="block text-sm text-neutral-600 leading-relaxed mt-1">
                {service.description}
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-x-8 gap-y-3 mt-10">
      <a href="/repairs" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors">
        See every repair we handle →
      </a>
      <a href="/remodeling" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors">
        See remodeling packages and pricing →
      </a>
    </div>
  </div>
</section>
