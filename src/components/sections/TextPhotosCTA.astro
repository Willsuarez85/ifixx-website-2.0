---
// The one speed promise iFIXX can keep (William, 2026-09-19): for small repairs,
// the customer sends photos and a description and a person calls back with the
// estimate the same business day. The number takes MMS, so the photos land in the
// CRM conversation on their own. There is deliberately no file upload here.
//
// Remodeling (kitchens, baths, new decks, porches) is priced in person instead,
// with a render included on projects over $5,000, so this block is for repair
// pages, hubs, /contact and the thank-you page, not for the remodeling silo.
interface Props {
  /** 'dark' sits on a dark section, 'light' on a white or neutral-50 one. */
  tone?: 'dark' | 'light';
  headline?: string;
  /** Extra classes for spacing at the call site. */
  class?: string;
}

const {
  tone = 'light',
  headline = 'Want a faster estimate? Text us photos.',
  class: extraClass = ''
} = Astro.props;

const body =
  'Send photos of the job to (980) 391-6833 with a short description of what needs fixing. A person looks at them and calls you back with the estimate the same business day.';

const wrapperClass =
  tone === 'dark'
    ? 'bg-neutral-900 border border-neutral-700'
    : 'bg-primary-50 border border-primary-200';
const headlineClass = tone === 'dark' ? 'text-white' : 'text-neutral-900';
const bodyClass = tone === 'dark' ? 'text-neutral-300' : 'text-neutral-600';
---

<div class={`rounded-xl p-6 lg:p-8 ${wrapperClass} ${extraClass}`}>
  <div class="flex flex-col sm:flex-row sm:items-center gap-5">
    <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center flex-shrink-0">
      <svg class="w-6 h-6 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 21l1.4-3.5A7.94 7.94 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class={`font-heading font-bold text-lg mb-1 ${headlineClass}`}>{headline}</p>
      <p class={`text-sm leading-relaxed ${bodyClass}`}>{body}</p>
    </div>
    <a
      href="sms:+19803916833"
      class="btn btn-primary whitespace-nowrap flex-shrink-0"
      data-event="sms_click"
    >
      Text (980) 391-6833
    </a>
  </div>
</div>
