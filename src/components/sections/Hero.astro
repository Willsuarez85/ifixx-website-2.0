---
const phoneHref = 'tel:+19803916833';
---

<section class="relative bg-neutral-900 overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <picture>
      <source
        srcset="/images/ui/hero-bg-640.webp 640w,
                /images/ui/hero-bg-1024.webp 1024w,
                /images/ui/hero-bg.webp 1600w"
        sizes="100vw"
        type="image/webp"
      />
      <img
        src="/images/ui/hero-bg.jpg"
        alt="iFIXX technician patching a drywall hole in a South Charlotte home"
        class="w-full h-full object-cover"
        width="1600"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <!-- Heavy Charcoal Gradient for Text Readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-900/95 via-neutral-900/80 to-neutral-900/40"></div>
  </div>
  
  <div class="container relative z-10">
    <div class="py-16 md:py-20 lg:py-28">
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-800 border border-neutral-700 mb-6">
          <span>🏆</span>
          <span class="font-bold text-sm tracking-wide uppercase text-white">Since 2019 <span class="text-primary-500">Fixing South Charlotte Homes</span></span>
        </div>
        
        <!-- H1 Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-heading font-bold text-white mb-6 leading-tight">
          Handyman &amp; Home Repairs in South Charlotte<br />
          <span class="text-primary-500">Kitchen &amp; Bathroom Remodeling Too</span>
        </h1>
        
        <!-- Subheadline: the three things iFIXX does every day, plus the promise it keeps -->
        <p class="text-lg md:text-xl text-neutral-200 mb-6 font-medium">
          Drywall repair, deck repair, and kitchen and bathroom remodeling.
          Text us photos of a small repair and we call you back with the estimate the same business day.
        </p>

        <!-- Trust Line -->
        <p class="text-base md:text-lg text-neutral-400 mb-8 max-w-xl">
          Painting, doors, fences, and the small jobs nobody else will take, too. Fully insured, family-owned, serving South Charlotte, Ballantyne, Pineville, and Matthews.
        </p>
        
        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn btn-primary text-lg px-8 py-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Request Free Estimate
          </a>
          <a 
            href={phoneHref}
            class="btn btn-secondary text-lg px-8 py-4"
            data-event="phone_click"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call (980) 391-6833
          </a>
        </div>
        
      </div>
    </div>
  </div>
</section>
