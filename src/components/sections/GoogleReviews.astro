---
import { GOOGLE_REVIEW_COUNT, GOOGLE_RATING } from '../../lib/business-facts';
import {
  GOOGLE_REVIEWS,
  GOOGLE_PROFILE_URL,
  reviewDateLabel,
  reviewsByAuthor,
} from '../../lib/google-reviews';

interface Props {
  title?: string;
  /** Cuantas resenas se muestran. El resto vive en el perfil de Google. */
  max?: number;
  /** Seleccion explicita por autor (hubs). Si se pasa, manda sobre `max`. */
  authors?: readonly string[];
}

const { title = 'What Our Customers Say', max = 6, authors } = Astro.props;

// Solo resenas verificadas en el Google Business Profile. Ver src/lib/google-reviews.ts.
const reviews = authors ? reviewsByAuthor(authors) : GOOGLE_REVIEWS.slice(0, max);
const averageRating = GOOGLE_RATING;
const totalReviews = GOOGLE_REVIEW_COUNT;

// El texto se guarda completo; si es largo se recorta solo visualmente.
const LONG_REVIEW = 260;
---

<section class="section">
  <div class="container">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl lg:text-3xl font-heading font-bold text-neutral-900 mb-4">
        {title}
      </h2>

      <!-- Overall Rating -->
      <div class="flex items-center justify-center gap-4">
        <div class="flex items-center gap-1">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-2xl font-bold text-neutral-900">{averageRating}</span>
        <span class="text-neutral-500">({totalReviews} reviews on Google)</span>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {reviews.map((review, index) => (
        <div class="bg-white rounded-xl p-6 shadow-sm border border-neutral-100">
          <!-- Header -->
          <div class="flex items-start gap-4 mb-4">
            <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center shrink-0">
              <span class="text-primary-700 font-bold text-lg">{review.author.charAt(0)}</span>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <h4 class="font-semibold text-neutral-900">{review.author}</h4>
                <img
                  src="https://www.google.com/favicon.ico"
                  alt="Google"
                  class="w-5 h-5 shrink-0"
                  loading="lazy"
                />
              </div>
              <div class="flex items-center gap-2 mt-1">
                <div class="flex">
                  {[...Array(review.rating)].map(() => (
                    <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="text-sm text-neutral-500">{reviewDateLabel(review.datePublished)}</span>
              </div>
            </div>
          </div>

          <!-- Review Text (verbatim; si es larga se recorta solo a la vista) -->
          {review.text.length > LONG_REVIEW ? (
            <div class="mb-3">
              <input type="checkbox" id={`gr-${index}-${review.datePublished}`} class="peer sr-only" />
              <p class="text-neutral-600 leading-relaxed whitespace-pre-line line-clamp-5 peer-checked:line-clamp-none">
                "{review.text}"
              </p>
              <label
                for={`gr-${index}-${review.datePublished}`}
                class="mt-1 inline-block cursor-pointer text-sm font-semibold text-primary-600 hover:text-primary-700 peer-checked:hidden"
              >
                Read more
              </label>
            </div>
          ) : (
            <p class="text-neutral-600 leading-relaxed whitespace-pre-line mb-3">
              "{review.text}"
            </p>
          )}

          <!-- Source -->
          <a
            href={review.reviewUrl ?? GOOGLE_PROFILE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold uppercase tracking-wide text-neutral-500 hover:text-primary-600 transition-colors"
          >
            Review on Google
          </a>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10">
      <a
        href={GOOGLE_PROFILE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-medium transition-colors"
      >
        <span>Read all {totalReviews} reviews on Google</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>
