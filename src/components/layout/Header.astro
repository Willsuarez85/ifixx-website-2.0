---
const currentPath = Astro.url.pathname;

// "Reparar primero, remodelar despues" (William, 2026-09-17). Repairs leads the nav,
// remodeling follows. Fences left the nav the same day: the category moves to a
// separate brand in October, and /fence-*-south-charlotte stay live for Google Ads
// only, noindexed and unlinked.
// Emergency Services left the nav on 2026-09-19 (William): iFIXX cannot fulfil a
// same-day or emergency promise, so the silo was retired and 301'd to /repairs.
const navLinks = [
  {
    href: '/repairs',
    label: 'Repairs',
    dropdown: [
      { href: '/repairs', label: 'All Home Repairs', description: 'Drywall, painting, carpentry & more' },
      { href: '/repairs/drywall', label: 'Drywall Repair', description: 'Holes, cracks & texture matching' },
      { href: '/repairs/painting', label: 'Painting', description: 'Interior & exterior painting' },
      { href: '/repairs/deck-repair', label: 'Deck Repair', description: 'Rot, boards, railings & steps' },
      { href: '/repairs/fence-repair', label: 'Fence Repair', description: 'Leaning posts, gates & panels' },
      { href: '/repairs/quick-fix', label: 'Quick Fixes', description: 'The list nobody else will take' },
      { href: '/repairs/doors-windows', label: 'Doors & Windows', description: 'Sticking doors, frames & hardware' }
    ]
  },
  {
    href: '/remodeling',
    label: 'Remodeling',
    dropdown: [
      { href: '/remodeling/kitchen-remodeling', label: 'Kitchen Remodeling', description: 'Full kitchen renovations' },
      { href: '/remodeling/bathroom-remodeling', label: 'Bathroom Remodeling', description: 'Bathroom updates & remodels' },
      { href: '/remodeling/decks', label: 'Deck Building', description: 'New decks, rebuilds & composite' },
      { href: '/remodeling/screened-porches', label: 'Screened Porches', description: 'Screened in porches & conversions' }
    ]
  },
  { href: '/service-areas', label: 'Service Areas' },
  { href: '/gallery', label: 'Gallery' }
];

const phoneNumber = '(980) 391-6833';
const phoneHref = 'tel:+19803916833';

const isActivePath = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 bg-neutral-800/95 backdrop-blur-sm border-b border-neutral-700 shadow-xl">
  <nav class="container">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <picture>
          <source srcset="/images/ui/logo.webp" type="image/webp" />
          <img src="/images/ui/logo.png" alt="iFixx Logo" class="h-12 w-auto" width="107" height="48" />
        </picture>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-6">
        {navLinks.map((link) => (
          link.dropdown ? (
            <div class="relative group">
              <button
                class:list={[
                  "flex items-center gap-1 text-sm font-bold uppercase tracking-wide transition-colors hover:text-primary-500 py-6",
                  isActivePath(link.href) ? "text-primary-500" : "text-white"
                ]}
              >
                {link.label}
                <svg class="w-4 h-4 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Dropdown Menu -->
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-white rounded-xl shadow-2xl border border-neutral-200 py-2 min-w-[280px]">
                  {link.dropdown.map((item) => (
                    <a
                      href={item.href}
                      class="flex flex-col px-4 py-3 hover:bg-neutral-50 transition-colors"
                    >
                      <span class="font-bold text-sm text-neutral-900">
                        {item.label}
                      </span>
                      <span class="text-xs text-neutral-500">{item.description}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                "text-sm font-bold uppercase tracking-wide transition-colors hover:text-primary-500",
                isActivePath(link.href) ? "text-primary-500" : "text-white"
              ]}
            >
              {link.label}
            </a>
          )
        ))}
      </div>

      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href={phoneHref}
          class="hidden xl:inline-flex items-center gap-2 text-sm font-bold text-white hover:text-primary-500 transition-colors"
          data-event="phone_click"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {phoneNumber}
        </a>
        <a href="/contact" class="btn btn-primary">
          Free Estimate
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-white hover:text-primary-500 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden lg:hidden pb-4 bg-neutral-800 border-t border-neutral-700 absolute top-full left-0 right-0 shadow-xl px-4">
      <div class="flex flex-col gap-2 pt-4">
        {navLinks.map((link) => (
          link.dropdown ? (
            <div class="mobile-dropdown">
              <button
                class="mobile-dropdown-btn flex items-center justify-between w-full text-base font-bold uppercase py-3 border-b border-neutral-700 text-white"
              >
                {link.label}
                <svg class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="mobile-dropdown-content hidden pl-4 py-2 space-y-2">
                {link.dropdown.map((item) => (
                  <a
                    href={item.href}
                    class="block py-2 text-sm text-neutral-300 hover:text-white"
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                "text-base font-bold uppercase py-3 border-b border-neutral-700 transition-colors",
                isActivePath(link.href) ? "text-primary-500" : "text-white"
              ]}
            >
              {link.label}
            </a>
          )
        ))}
        <a
          href={phoneHref}
          class="flex items-center justify-center gap-2 py-3 text-base font-bold text-white border-b border-neutral-700"
          data-event="phone_click"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {phoneNumber}
        </a>
        <a href="/contact" class="btn btn-emergency w-full justify-center mt-4">
          Request Free Estimate
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Mobile dropdown toggles
  const dropdownBtns = document.querySelectorAll('.mobile-dropdown-btn');
  dropdownBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('svg');
      content?.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  });
</script>
