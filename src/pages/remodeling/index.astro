---
import { GOOGLE_REVIEW_COUNT } from '../../lib/business-facts';
import PillarLayout from '../../layouts/PillarLayout.astro';
import { getCollection } from 'astro:content';
import TrustBar from '../../components/sections/TrustBar.astro';
import GoogleReviews from '../../components/sections/GoogleReviews.astro';
import { REMODELING_FEATURED_AUTHORS } from '../../lib/google-reviews';
import { isRetiredService, hasServiceAreaHub } from '../../lib/seo-retired';

// Get all services with category 'remodeling', excluding retired ones
// (basement-finishing, outdoor-living).
const allServices = await getCollection('services');
const remodelingServices = allServices.filter(s => s.data.category === 'remodeling' && !isRetiredService(s.slug));

// Get all locations for internal linking — only those with a /service-areas hub
const locations = (await getCollection('cities')).filter(c => hasServiceAreaHub(c.slug));

const pillar = {
  title: "Home Remodeling Services",
  slug: "remodeling",
  description: "South Charlotte remodeling by the crew that already fixes your house. Kitchen and bathroom renovations inside, decks and screened porches outside. Family-owned, fully insured, working across South Charlotte, Ballantyne, Pineville, and Matthews.",
  seo: {
    title: "Remodeling South Charlotte NC | Kitchens, Baths & Decks | iFIXX",
    description: "Remodeling contractor in South Charlotte NC. Kitchen and bathroom renovations, deck building, and screened porches by an insured family-owned crew. Call (980) 391-6833."
  }
};

const services = remodelingServices.map(s => ({
  name: s.data.title,
  slug: s.slug,
  description: s.data.summary,
  image: s.data.heroImage
}));

// Interior / Exterior are how homeowners think about a remodel, so the hub shows
// them as two sections. They are headings only, never URL segments: every silo
// stays at /remodeling/{slug} (William, 2026-09-17).
const INTERIOR_SLUGS = ['kitchen-remodeling', 'bathroom-remodeling', 'flooring-installation'];
const EXTERIOR_SLUGS = ['decks', 'screened-porches'];
const order = (slugs: string[]) => (a: { slug: string }, b: { slug: string }) =>
  slugs.indexOf(a.slug) - slugs.indexOf(b.slug);

const groups = [
  {
    key: 'interior',
    title: 'Interior',
    blurb: 'The rooms you use every day. Kitchens and bathrooms are where a remodel pays you back twice: while you live in it and when you sell.',
    services: services.filter(s => INTERIOR_SLUGS.includes(s.slug)).sort(order(INTERIOR_SLUGS))
  },
  {
    key: 'exterior',
    title: 'Exterior',
    blurb: 'Outdoor space is the cheapest square footage you can add in Charlotte, and you get to use it most of the year.',
    services: services.filter(s => EXTERIOR_SLUGS.includes(s.slug)).sort(order(EXTERIOR_SLUGS))
  }
].filter(g => g.services.length > 0);

// Anything new that is not yet assigned to a group still has to render somewhere.
const grouped = new Set(groups.flatMap(g => g.services.map(s => s.slug)));
const ungrouped = services.filter(s => !grouped.has(s.slug));
if (ungrouped.length > 0) {
  groups.push({ key: 'more', title: 'More Remodeling Services', blurb: '', services: ungrouped });
}
---

<PillarLayout pillar={pillar} services={services}>
  <!-- Hero Section -->
  <section class="relative bg-neutral-900 py-20 lg:py-28">
    <div class="absolute inset-0">
      <img
        src="/images/projects/kitchen-remodeling-luxury-white-cabinets-island-pendant-lights.webp"
        alt="Kitchen remodeling project in Charlotte"
        class="w-full h-full object-cover opacity-30"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-neutral-900 via-neutral-900/90 to-neutral-900/70"></div>
    </div>
    <div class="container relative">
      <div class="max-w-3xl">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-neutral-400 mb-6">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-primary-500">Remodeling</span>
        </nav>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Remodeling in <span class="text-primary-500">South Charlotte</span>
        </h1>
        <p class="text-xl text-neutral-300 mb-8 leading-relaxed">
          Kitchens and bathrooms inside, decks and screened porches outside. Same
          family-owned crew that handles the repairs, fully insured, with the price in
          writing before anything starts. Working South Charlotte, Ballantyne, Pineville,
          and Matthews.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn btn-primary text-lg px-8 py-4">
            Schedule Free Consultation
          </a>
          <a href="tel:+19803916833" class="btn btn-outline-light text-lg px-8 py-4">
            Call (980) 391-6833
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <TrustBar />

  <!-- Services Grid: Interior / Exterior -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">
          What We Remodel
        </h2>
        <p class="text-lg text-neutral-600">
          Two kinds of project, one crew. Inside the house we rebuild the rooms you use
          every day. Outside, we build the space you only get to use if somebody builds it.
        </p>
      </div>

      {groups.map((group) => (
        <div class="mb-16 last:mb-0">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-8 pb-4 border-b border-neutral-200">
            <h3 class="text-2xl md:text-3xl font-bold text-neutral-900">{group.title}</h3>
            {group.blurb && <p class="text-neutral-600 md:max-w-xl md:text-right">{group.blurb}</p>}
          </div>

          <div class="grid md:grid-cols-2 gap-8">
            {group.services.map((service) => (
              <a
                href={`/remodeling/${service.slug}`}
                class="group relative bg-neutral-50 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300"
              >
                <div class="grid md:grid-cols-2">
                  <div class="aspect-square md:aspect-auto overflow-hidden">
                    <img
                      src={service.image}
                      alt={`${service.name} in South Charlotte, NC`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                      width="400"
                      height="400"
                    />
                  </div>
                  <div class="p-6 flex flex-col justify-center">
                    <h4 class="text-2xl font-bold text-neutral-900 mb-3 group-hover:text-primary-600 transition-colors">
                      {service.name}
                    </h4>
                    <p class="text-neutral-600 mb-4">
                      {service.description}
                    </p>
                    <span class="inline-flex items-center text-primary-600 font-semibold">
                      See details &amp; pricing
                      <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-16 lg:py-24 bg-neutral-900 text-white">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          Our Remodeling Process
        </h2>
        <p class="text-lg text-neutral-300">
          From initial consultation to final walkthrough, we guide you through every step.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-white">1</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Consultation</h3>
          <p class="text-neutral-400 text-sm">
            We discuss your vision, assess the space, and understand your goals and budget.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-white">2</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Design</h3>
          <p class="text-neutral-400 text-sm">
            We create a detailed plan with materials, finishes, and a clear timeline.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-white">3</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Build</h3>
          <p class="text-neutral-400 text-sm">
            Our skilled craftsmen execute the project with precision and care.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl font-bold text-white">4</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Reveal</h3>
          <p class="text-neutral-400 text-sm">
            Final walkthrough to ensure everything exceeds your expectations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative order-2 lg:order-1">
          <img
            src="/images/projects/Ifixx-portfolio28.webp"
            alt="Bathroom remodeled by iFIXX in South Charlotte NC"
            class="rounded-2xl shadow-2xl"
            loading="lazy"
            decoding="async"
            width="600"
            height="450"
          />
          <div class="absolute -bottom-6 -right-6 bg-primary-500 text-white p-6 rounded-xl shadow-xl">
            <p class="text-4xl font-bold">{GOOGLE_REVIEW_COUNT}</p>
            <p class="text-sm">Google Reviews</p>
          </div>
        </div>

        <div class="order-1 lg:order-2">
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6">
            Why South Charlotte Homeowners Trust iFixx
          </h2>
          <p class="text-neutral-600 text-lg mb-8">
            We're not a big box contractor or a national franchise. We're a local Charlotte family
            who has been doing this since 2019. Most of our remodels start as a repair call, which
            means you already know how we work before you hand us the big job.
          </p>

          <ul class="space-y-4">
            <li class="flex items-start gap-4">
              <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-bold text-neutral-900">Charlotte Projects, Start to Finish</h3>
                <p class="text-neutral-600 text-sm">We know Charlotte homes—from 1920s bungalows to new construction in Ballantyne.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-bold text-neutral-900">One Point of Contact</h3>
                <p class="text-neutral-600 text-sm">You talk to us directly—not a call center, not a random sub. The same team from start to finish.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-bold text-neutral-900">We Live Here Too</h3>
                <p class="text-neutral-600 text-sm">Our kids go to school here. We shop at Harris Teeter. Your neighbor probably knows us.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-6 h-6 text-primary-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-bold text-neutral-900">Fully Insured</h3>
                <p class="text-neutral-600 text-sm">Full liability coverage for every project. Peace of mind included.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews: las tres del perfil de Google que hablan de remodel y acabados -->
  <GoogleReviews
    title="What South Charlotte Homeowners Say About Our Remodels"
    authors={REMODELING_FEATURED_AUTHORS}
  />

  <!-- Service Areas -->
  <section class="py-16 lg:py-24 bg-neutral-50">
    <div class="container">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">
          Remodeling Services Near You
        </h2>
        <p class="text-lg text-neutral-600">
          South Charlotte is home base. We also work Ballantyne, Pineville, Matthews, and the
          surrounding Charlotte neighborhoods.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {locations.map((location) => (
          <a
            href={`/service-areas/${location.slug}`}
            class="bg-white p-4 rounded-lg text-center hover:bg-primary-50 hover:border-primary-200 border border-neutral-200 transition-colors"
          >
            <span class="font-semibold text-neutral-900">{location.data.name}</span>
            <span class="text-neutral-500 text-sm ml-1">{location.data.state}</span>
          </a>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/service-areas" class="text-primary-600 font-semibold hover:text-primary-700 transition-colors">
          View All Service Areas →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-24 bg-primary-600">
    <div class="container text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready to Transform Your Space?
      </h2>
      <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
        Schedule a free consultation to discuss your remodeling project. No obligation, just expert advice.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn bg-white text-primary-600 hover:bg-neutral-100 text-lg px-8 py-4">
          Schedule Free Consultation
        </a>
        <a href="tel:+19803916833" class="btn btn-outline-light text-lg px-8 py-4">
          Call Now: (980) 391-6833
        </a>
      </div>
    </div>
  </section>
</PillarLayout>
